# ─────────────────────────────────────────────────────────
# AI 산학협력 관리 시스템 - 환경변수 예시
# 이 파일을 복사해서 .env 로 만들고 값을 채우세요. (.env 는 git 에 올라가지 않음)
#
# 운영은 서버실 PC 자체호스팅(Docker) 한 곳이다. DB 도 그 서버의 PostgreSQL 이다.
# 서버의 .env 는 env_file 로 물려 있어 deploy.sh 로 새 이미지를 올려도 유지된다.
# ─────────────────────────────────────────────────────────

# [필수] PostgreSQL 연결 문자열
#  - 운영(서버실 PC): docker-compose.prod.yml 의 db 서비스(postgres:17)를 본다.
#      DATABASE_URL="postgresql://cms:여기에_POSTGRES_PASSWORD@db:5432/cms?schema=public"
#      DIRECT_URL="postgresql://cms:여기에_POSTGRES_PASSWORD@db:5432/cms?schema=public"
#    (앱 컨테이너가 docker 네트워크로 붙으므로 호스트명이 db. 둘 다 같은 값)
#  - 로컬 개발: 아래 "로컬 DB" 참고. 호스트는 localhost.
#  주의: 비밀번호에 @ 나 : 가 들어가면 URL 파싱이 깨진다. 퍼센트 인코딩하거나 안 쓰는 게 안전하다.
DATABASE_URL="postgresql://cms:PASSWORD@localhost:5432/cms?schema=public"
DIRECT_URL="postgresql://cms:PASSWORD@localhost:5432/cms?schema=public"

# [운영-필수] db 컨테이너가 만들 postgres 계정 비밀번호.
#  docker-compose.prod.yml 의 db 서비스가 이 값을 읽는다. 위 DATABASE_URL 의 비밀번호와 같아야 한다.
#  로컬에서 compose 를 안 쓰면 필요 없다.
POSTGRES_PASSWORD=""

# [필수] NextAuth (Auth.js) v5 인증 설정
#  - Google OAuth 로 @pusan.ac.kr 도메인만 로그인 허용
#
#  발급 방법:
#   1) https://console.cloud.google.com 접속 > 프로젝트 선택(또는 생성)
#      · 현재 쓰는 클라이언트는 프로젝트 'pnuaicms-497711'(번호 268994611342) 소속이다.
#        이름이 비슷한 다른 프로젝트에는 없으니 헷갈리지 말 것.
#   2) 'APIs & Services' > 'Credentials' > 'Create Credentials' > 'OAuth client ID'
#   3) Application type: Web application
#   4) Authorized redirect URIs 등록 (운영 주소 + 로컬):
#       - https://aicms.pusan.ac.kr/api/auth/callback/google
#       - http://localhost:3000/api/auth/callback/google
#   5) 발급된 Client ID/Secret 을 아래에 붙여넣기
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# [필수] NextAuth 세션 토큰 서명용 비밀키 (32바이트 랜덤 문자열)
#  생성 방법:
#   PowerShell:
#     [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Minimum 0 -Maximum 256}))
#   Bash/macOS:
#     openssl rand -base64 32
#   또는 npx auth secret
AUTH_SECRET=""

# [운영-필수] 공개 주소. 리버스 프록시(Caddy) 뒤라 자동 추론이 안 되므로 명시한다.
#  없으면 로그인 콜백이 내부 주소로 잡혀 깨진다. 로컬은 비워도 된다.
AUTH_URL="https://aicms.pusan.ac.kr"

# [운영-필수] 자체호스팅 프로덕션 모드에서 Host 헤더를 신뢰할지.
#  Auth.js v5 는 프로덕션에서 Host 를 자동으로 믿지 않는다. 이 값이 없으면 로그인 시
#  UntrustedHost 에러가 나고 화면에는 "There is a problem with the server configuration" 만 뜬다.
#  따옴표 없이 true 로 둔다. 로컬 개발에는 불필요.
AUTH_TRUST_HOST=true

# [선택] 로그인 우회 스위치 (개발/시연 임시용)
#  - "true" 로 두면 로그인 없이 SUPER 테스트 계정으로 접근된다.
#  - 로컬 개발에서 Google OAuth 설정 없이 빠르게 띄울 때만 사용.
#  - !! 운영에서는 반드시 "false" 또는 미설정 !!
#    외부에 공개된 주소라 true 면 누구나 슈퍼관리자로 들어와 학생 실명·연락처를 본다.
AUTH_BYPASS="false"

# [운영-필수] 부트스트랩 슈퍼관리자 이메일(쉼표 구분)
#  - 여기 적힌 @pusan.ac.kr 계정은 로그인 시 항상 SUPER(슈퍼관리자)로 보정됨.
#  - 이 값이 없으면 슈퍼관리자가 아무도 안 생겨 /admin/users 에 못 들어간다.
#  - 최초 1명(개발자)로 시작 → 이후 /admin/users 에서 나머지 권한 부여.
#  - 로컬은 AUTH_BYPASS=true 면 SUPER 로 통과하므로 굳이 없어도 됨.
#  예) SUPER_ADMIN_EMAILS="dev@pusan.ac.kr"
SUPER_ADMIN_EMAILS=""

# [선택] 자동조회 외부 API 키 - 없으면 자동조회 기능만 비활성, 나머지는 정상 동작
#  - DART: https://opendart.fss.or.kr 에서 발급 (40자)
DART_API_KEY=""
#  - 네이버 검색 API: https://developers.naver.com 애플리케이션 등록
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────
# 로컬 DB 띄우기 (운영 DB 는 교내망 전용이라 로컬에서 직접 못 닿는다)
#   docker run -d --name cms-local-db -p 5432:5432 \
#     -e POSTGRES_USER=cms -e POSTGRES_PASSWORD=cms -e POSTGRES_DB=cms postgres:17
#   npm run db:push   # 스키마 생성
# 운영 데이터를 봐야 하면 SSH 터널로 붙는다(운영 DB 는 127.0.0.1:5432 에만 바인딩돼 있음).
# 그 경우 로컬에서 db:push / 실적 엑셀 업로드 같은 쓰기 작업은 하지 말 것(운영 데이터 교체됨).
# ─────────────────────────────────────────────────────────
